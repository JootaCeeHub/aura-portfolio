\t\t\t</div>\r\n\r\n\t\t\t\t<div className=\"mt-4 text-xs text-slate-400\">\r\n\t\t\t\t\tGreen: &lt; 100ms | Yellow: 100-200ms | Red: &gt; 200ms\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t{/* Top Slowest Agents */}\r\n\t\t\t<div className=\"bg-slate-800 rounded-lg border border-slate-700 p-4\">\r\n\t\t\t\t<h3 className=\"text-lg font-bold text-cyan-400 mb-4\">Top Slowest Agents</h3>\r\n\r\n\t\t\t\t<div className=\"space-y-2\">\r\n\t\t\t\t\t{allStats\r\n\t\t\t\t\t\t.sort((a, b) => b.p99Latency - a.p99Latency)\r\n\t\t\t\t\t\t.slice(0, 5)\r\n\t\t\t\t\t\t.map((agent, idx) => (\r\n\t\t\t\t\t\t\t<div key={agent.name} className=\"flex justify-between items-center bg-slate-700 p-2 rounded\">\r\n\t\t\t\t\t\t\t\t<div className=\"flex items-center gap-2\">\r\n\t\t\t\t\t\t\t\t\t<span className=\"text-slate-400 text-xs\">{idx + 1}.</span>\r\n\t\t\t\t\t\t\t\t\t<span className=\"text-cyan-400\">{agent.name}</span>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div className=\"flex gap-4\">\r\n\t\t\t\t\t\t\t\t\t<span className=\"text-orange-400\">p99: {Math.round(agent.p99Latency)}ms</span>\r\n\t\t\t\t\t\t\t\t\t<span className=\"text-yellow-400\">avg: {Math.round(agent.averageLatency)}ms</span>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t))}\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t);\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\JACOB CERVANTES\\Documents\\PROGRAMING\\AURA\\core-aura-mcp\\ui\\src\\components\\MetricsPanel.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\JACOB CERVANTES\\Documents\\PROGRAMING\\AURA\\core-aura-mcp\\ui\\src\\components\\containers\\DashboardContainer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\JACOB CERVANTES\\Documents\\PROGRAMING\\AURA\
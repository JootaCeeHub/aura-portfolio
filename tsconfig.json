{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "noImplicitAny": false,
    "allowJs": true,
    "inlineSourceMap": true,
    "types": ["node"]
  },
  "include": ["core-aura-mcp/src", "packages/**/src", "scripts", "tests", "src"],
  "exclude": ["node_modules", "dist", "coverage"]
}

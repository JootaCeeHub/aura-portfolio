{
  "name": "aura-mcp",
  "version": "1.0.0",
  "description": "AURA MCP - Agent Orchestration & Automation Framework",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "aura": "packages/cli/dist/bin/run.js"
  },
  "scripts": {
    "dev": "npm run dev --workspace=core-aura-mcp",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "cli": "node packages/cli/dist/bin/run.js",
    "ingest": "npm run cli -- ingest",
    "validate": "npm run cli -- validate",
    "clean": "rm -rf dist coverage node_modules && npm ci"
  },
  "workspaces": [
    "core-aura-mcp",
    "packages/*"
  ],
  "dependencies": {
    "chokidar": "^3.5.3",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^2.0.1",
    "pdfjs-dist": "^5.4.449",
    "pdfreader": "^3.0.8",
    "pg": "^8.10.0",
    "redis": "^4.6.0",
    "sharp": "^0.32.0",
    "ws": "^8.14.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/chokidar": "^2.1.3",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^8.45.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.1.0",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

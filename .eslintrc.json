{
  "root": true,
  "env": {
    "node": true,
    "es2021": true,
    "vitest/globals": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "plugins": ["vitest"]
}

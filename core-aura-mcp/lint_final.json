ter((c) => c !== col)\r\n\t\t\t\t: [...p.visibleColumns, col],\r\n\t\t}));\r\n\t}, [updatePrefs]);\r\n\r\n\tconst toggleAgentExpanded = useCallback((agentName: string) => {\r\n\t\tupdatePrefs((p) => ({\r\n\t\t\t...p,\r\n\t\t\texpandedAgents: p.expandedAgents.includes(agentName)\r\n\t\t\t\t? p.expandedAgents.filter((a) => a !== agentName)\r\n\t\t\t\t: [...p.expandedAgents, agentName],\r\n\t\t}));\r\n\t}, [updatePrefs]);\r\n\r\n\treturn {\r\n\t\tprefs,\r\n\t\tupdatePrefs,\r\n\t\ttoggleDarkMode,\r\n\t\ttoggleColumnVisibility,\r\n\t\ttoggleAgentExpanded,\r\n\t};\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\JACOB CERVANTES\\Documents\\PROGRAMING\\AURA\\core-aura-mcp\\ui\\src\\services\\mcpCoreClient.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\JACOB CERVANTES\\Documents\\PROGRAMING\\AURA\\core-aura-mcp\\ui\\tests\\DashboardContainer.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\JACOB CERVANTES\\Documents\\PROGRAMING\\AURA\\core-aura-mcp\\ui\\vite-env.d.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\JACOB CERVANTES\\Documents\\PROGRAMING\\AURA\\core-aura-mcp\\ui\\vite.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]
